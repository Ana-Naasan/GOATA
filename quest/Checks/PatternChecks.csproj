<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <CachedNewtonsoft Include="../Library/PackageCache/com.unity.nuget.newtonsoft-json@*/Runtime/Newtonsoft.Json.dll" />
    <CachedNewtonsoft Condition="'@(CachedNewtonsoft)' == ''" Include="$(HOME)/Library/Caches/HTH/Unity-PassthroughCameraApiSamples/Library/PackageCache/com.unity.nuget.newtonsoft-json@*/Runtime/Newtonsoft.Json.dll" />
  </ItemGroup>
  <PropertyGroup>
    <NewtonsoftJsonPath Condition="'$(NewtonsoftJsonPath)' == ''">@(CachedNewtonsoft)</NewtonsoftJsonPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PatternChecks.cs" />
    <Compile Include="../Assets/Physio/Replay/MotionPatternClassifier.cs" />
    <Compile Include="../Assets/Physio/Replay/ReplayData.cs" />
    <Compile Include="../Assets/Physio/Replay/ReplayClock.cs" />
    <Compile Include="../Assets/Physio/Replay/ReplayTimeline.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(NewtonsoftJsonPath)</HintPath></Reference>
  </ItemGroup>
</Project>
