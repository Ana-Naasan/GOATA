# Build the verified GVHMR image first. This adds a separate Python 3.11
# service environment without upgrading the Python 3.10 model dependencies.
# Context must contain only this Dockerfile, root pyproject.toml and uv.lock.
FROM physio-gvhmr:ee960bb

COPY pyproject.toml uv.lock /opt/physio-service/
RUN /opt/conda/bin/python -m pip install --no-cache-dir --disable-pip-version-check \
      --retries 0 --timeout 30 uv==0.12.19 \
    && UV_HTTP_RETRIES=0 UV_HTTP_TIMEOUT=30 \
       UV_PYTHON_INSTALL_DIR=/opt/physio-python \
       UV_PROJECT_ENVIRONMENT=/opt/physio-service-venv \
       /opt/conda/bin/uv sync --project /opt/physio-service --locked \
         --no-dev --extra microscope --python 3.11.10 \
    && /opt/physio-service-venv/bin/python -c 'import fastapi, av, cv2, numpy; print("service imports verified")' \
    && /opt/conda/bin/python -c 'import torch; assert torch.__version__ == "2.3.0+cu121"'

ENV PYTHONPATH=/app:/opt/GVHMR PYTHONDONTWRITEBYTECODE=1
WORKDIR /opt/GVHMR
ENTRYPOINT ["/opt/physio-service-venv/bin/python", "-m", "processing"]
