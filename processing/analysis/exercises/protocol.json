        "Error3": "Participant lifts buttocks from chair and leans too far"
      }
    },
    "rtk": {
      "protocol": "seated torso rotation",
      "labels": {
        "Error1": "One or both arms not raised enough to horizontal",
        "Error2": "Participant does not turn torso enough",
        "Error3": "Participant lifts buttocks from chair and leans sideways during rotation"
      }
    }
  },
